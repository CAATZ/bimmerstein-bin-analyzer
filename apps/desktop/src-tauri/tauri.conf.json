{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BimmerStein Bin Analyzer",
  "version": "0.2.2",
  "identifier": "com.bimmerstein.binanalyzer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BimmerStein Bin Analyzer",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
