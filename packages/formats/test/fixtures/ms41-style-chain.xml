<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE roms [
<!ENTITY deg "&#176;" >
]>
<roms>
<rom> FAMBASE — structure only, no addresses
  <romid>
   <xmlid>FAMBASE</xmlid>
   <internalidaddress>0000</internalidaddress>
   <internalidstring>00000000</internalidstring>
  </romid>
  <table type="3D" name="Ignition Base" category="Ignition" storagetype="uint8" sizex="12" sizey="16" userlevel="1">
    <scaling units="&deg;BTDC" expression="(x*.375)-23.6" to_byte="(x+23.6)/.375" format="0.00" fineincrement=".1" coarseincrement="1"/>
    <table type="X Axis" name="Load" storagetype="uint16" endian="little">
      <scaling units="mg/stroke" expression="x*(1389/65535)" to_byte="x/(1389/65535)" format="#"/>
    </table>
    <table type="Y Axis" name="Engine Speed" storagetype="uint16" endian="little">
      <scaling units="RPM" expression="x" to_byte="x" format="#"/>
    </table>
    <description>Main ignition timing advance map.</description>
  </table>
  <table type="3D" name="MAF" category="Sensors" storagetype="uint16" endian="little" sizex="2" sizey="2">
    <scaling units="kg/hr" expression="x*.015625" to_byte="x/.015625" format="0.00"/>
    <table type="Static X Axis" name="Volts"><data>0.00</data><data>0.02</data></table>
    <table type="Static Y Axis" name="Volts"><data>0.00</data><data>0.32</data></table>
  </table>
  <table type="2D" name="Idle Target" category="Idle" storagetype="uint16" endian="little" sizey="6">
    <scaling units="RPM" expression="x" to_byte="x" format="0"/>
    <table type="Y Axis" name="Coolant Temperature" storagetype="uint8">
      <scaling units="&deg;C" expression="x*.75-48" to_byte="(x+48)/.75" format="0"/>
    </table>
  </table>
  <table type="Switch" name="EWS Delete" storagetype="uint8" sizey="1">
    <state name="On" data="96"/>
    <state name="Off" data="22"/>
  </table>
</rom>

<rom base="FAMBASE"> MIDBASE — addresses for the 24KB framing
  <romid>
   <xmlid>MIDBASE</xmlid>
  </romid>
  <table name="Ignition Base" storageaddress="0xE7E">
    <table type="X Axis" storageaddress="0x898"/>
    <table type="Y Axis" storageaddress="0x8B2"/>
  </table>
  <table name="MAF" storageaddress="0x2AD6"/>
  <table name="Idle Target" storageaddress="0x510"/>
</rom>

<rom base="MIDBASE"> LEAF, 24KB framing
  <romid>
   <internalidaddress>E</internalidaddress>
   <internalidstring>12</internalidstring>
   <xmlid>12</xmlid>
  </romid>
  <table name="MAF">
    <scaling units="kg/hr [x2]" format="0.0"/>
  </table>
</rom>

<rom base="FAMBASE"> LEAF, 256KB framing — same xmlid, resolves fewer maps
  <romid>
   <internalidaddress>1400E</internalidaddress>
   <internalidstring>12</internalidstring>
   <xmlid>12</xmlid>
  </romid>
  <table name="Ignition Base" storageaddress="0x14E7E"/>
</rom>
</roms>
